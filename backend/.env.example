# Copy this file to `.env` and adjust values for your environment.

# --- Database ---
# Local SQLite (zero-setup dev default):
DATABASE_URL=sqlite:///./korvexa.db

# Local Postgres via docker-compose (see /docker-compose.yml):
# DATABASE_URL=postgresql+psycopg2://korvexa:korvexa@localhost:5432/korvexa

# Supabase (or any managed Postgres) — use the connection string from your
# Supabase project settings (Database > Connection string > URI), driver
# prefix changed to psycopg2:
# DATABASE_URL=postgresql+psycopg2://postgres:[PASSWORD]@[HOST]:5432/postgres

# --- App ---
ENVIRONMENT=development
# JSON array of allowed CORS origins. Use your web app's origin in production,
# e.g. ["https://app.example.com"].
CORS_ORIGINS=["*"]

# --- Auth ---
# Generate a long random value in production, e.g. `openssl rand -hex 32`.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200
# bcrypt work factor (keep >= 12 in production; tests lower it themselves).
BCRYPT_ROUNDS=12

# --- Hardening ---
# Rate limit for auth endpoints (slowapi syntax).
RATE_LIMIT_AUTH=10/minute

# --- Demo seed (optional) ---
# When true, `entrypoint.sh` runs `python -m app.seed` on container start.
SEED_DEMO=false
