# Copy this file to `.env` and adjust values for your environment.

# --- Database ---
# Local SQLite (zero-setup dev default):
DATABASE_URL=sqlite:///./korvexa.db

# Local Postgres via docker-compose (see /docker-compose.yml):
# DATABASE_URL=postgresql+psycopg2://korvexa:korvexa@localhost:5432/korvexa

# Supabase (or any managed Postgres) — use the connection string from your
# Supabase project settings (Database > Connection string > URI), driver
# prefix changed to psycopg2:
# DATABASE_URL=postgresql+psycopg2://postgres:[PASSWORD]@[HOST]:5432/postgres

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=["*"]

# --- Auth (Phase 3) ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# --- Seed (Phase 1, first-run only, ignored once a user exists) ---
SEED_USER_EMAIL=owner@example.com
SEED_USER_NAME=Workspace Owner
SEED_WORKSPACE_NAME=My Workspace
